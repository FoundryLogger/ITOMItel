# Avvio automatico del totem sul Raspberry Pi.
# Installazione: vedi README.md, sezione "Avvio automatico".
[Unit]
Description=ITOMItel - catalogo ITOMI.shop sul terminale Videotel
After=network-online.target
Wants=network-online.target

[Service]
User=itomitel
WorkingDirectory=/home/itomitel/ITOMItel
ExecStart=/usr/bin/python3 -m totem serial --port /dev/serial0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
